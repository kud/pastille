<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Nothing goes to Google's cloud backup; a device-to-device transfer
     (cable or Wi-Fi, phone to phone) carries the snippets, their images, the settings, the sync
     state and the crash log. fullBackupContent covers Android 9 to 11 with the same split. Keep
     both files and BackupRulesTest in step when a new file or folder appears under the app's storage. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="images/" />
        <include domain="file" path="crashes/" />
        <include domain="file" path="sync/" />
        <include domain="sharedpref" path="pastille_settings.xml" />
    </device-transfer>
</data-extraction-rules>
