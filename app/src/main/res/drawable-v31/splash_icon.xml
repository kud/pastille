<?xml version="1.0" encoding="utf-8"?>
<!--
    The pastille mark assembling, in about half a second, on the splash (Iris, 2026-10-28): the blue
    back disc swells into place, the cream card lands on it with a slight turn, its two ink panels
    draw left to right, and the red corner folds down last. Every target is the still mark
    (drawable/splash_icon.xml), so a cut-short splash, or "Remove animations" (the system then
    skips to the end), shows the finished icon. Each start is a hold on the starting value (a delayed animator would show the still mark first), staggered, never longer than 520 ms
    (windowSplashScreenAnimationDuration).
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">
            <!-- The navy disc the system used to draw (windowSplashScreenIconBackgroundColor), now ours so the word can sit under it. -->
            <path android:fillColor="@color/ic_launcher_background" android:pathData="M200,121 A56,56 0,1 1,88 121 A56,56 0,1 1,200 121 Z" />
            <group android:name="mark" android:scaleX="0.16398" android:scaleY="0.16398" android:translateX="60.04" android:translateY="37.04">
                <!-- The launcher's own circle (72 of 108dp), which the system used to mask with. -->
                <clip-path android:pathData="M853.5,512 A341.5,341.5 0,1 1,170.5 512 A341.5,341.5 0,1 1,853.5 512 Z" />
                <group android:name="back" android:pivotX="456" android:pivotY="548">
                    <path android:name="backFill" android:fillColor="@color/ic_launcher_back" android:pathData="M730,548 A274,274 0,1 1,182 548 A274,274 0,1 1,730 548 Z" />
                </group>
                <group android:name="card" android:pivotX="512" android:pivotY="560">
                    <path android:name="frontFill" android:fillColor="@color/ic_launcher_front" android:pathData="M352,204 C267,225 216,304 206,393 C196,482 213,601 263,692 C316,789 415,832 532,824 C649,816 753,772 803,687 C850,607 849,491 825,402 C807,334 755,291 703,246 C654,204 583,187 505,188 C448,188 397,194 352,204 Z" />
                    <group android:name="panel1" android:pivotX="326" android:pivotY="457">
                        <path android:fillColor="@color/ic_launcher_ink" android:pathData="M369,382 H672 A43,43 0,0 1,715 425 V489 A43,43 0,0 1,672 532 H369 A43,43 0,0 1,326 489 V425 A43,43 0,0 1,369 382 Z" />
                        <path android:fillColor="@color/ic_launcher_front" android:pathData="M383,420 H594 A12,12 0,0 1,606 432 A12,12 0,0 1,594 444 H383 A12,12 0,0 1,371 432 A12,12 0,0 1,383 420 Z M383,464 H504 A12,12 0,0 1,516 476 A12,12 0,0 1,504 488 H383 A12,12 0,0 1,371 476 A12,12 0,0 1,383 464 Z" />
                    </group>
                    <group android:name="panel2" android:pivotX="326" android:pivotY="633">
                        <path android:fillColor="@color/ic_launcher_ink" android:pathData="M369,557 H672 A43,43 0,0 1,715 600 V667 A43,43 0,0 1,672 710 H369 A43,43 0,0 1,326 667 V600 A43,43 0,0 1,369 557 Z" />
                        <path android:fillColor="@color/ic_launcher_front" android:pathData="M476,608 A18,18 0,1 1,440 608 A18,18 0,1 1,476 608 Z M361,675 L405,626 L446,670 L470,645 L505,684 L361,684 Z M540,596 H654 A12,12 0,0 1,666 608 A12,12 0,0 1,654 620 H540 A12,12 0,0 1,528 608 A12,12 0,0 1,540 596 Z M540,642 H610 A12,12 0,0 1,622 654 A12,12 0,0 1,610 666 H540 A12,12 0,0 1,528 654 A12,12 0,0 1,540 642 Z" />
                    </group>
                    <group android:name="fold" android:pivotX="816" android:pivotY="207">
                        <path android:fillColor="@color/ic_launcher_fold" android:pathData="M661,236 C661,220 674,207 690,207 C701,207 711,212 719,220 L803,304 C811,312 816,322 816,334 C816,350 803,363 787,363 L728,363 C691,363 661,333 661,296 Z" />
                    </group>
                </group>
            </group>
            <!-- "Pastille", Inter Bold 26dp outlined (a drawable can't use the system font), baseline 223, in the list header's ink. -->
            <group android:translateY="6">
                <path android:fillColor="@color/splash_wordmark" android:pathData="M100.39 217H104.26V210.82H107.67C112.03 210.82 114.53 208.21 114.53 204.47C114.53 200.75 112.07 198.08 107.76 198.08H100.39ZM104.26 207.69V201.28H107.04C109.41 201.28 110.53 202.57 110.53 204.47C110.53 206.37 109.41 207.69 107.05 207.69ZM120.71 217.28C122.81 217.28 124.18 216.35 124.87 215.03H124.99V217H128.6V207.44C128.6 204 125.63 202.63 122.58 202.63C119.41 202.63 117.12 204.04 116.4 206.5L119.89 207.08C120.19 206.17 121.1 205.45 122.57 205.45C123.99 205.45 124.79 206.13 124.79 207.34V207.4C124.79 208.33 123.79 208.43 121.35 208.67C118.56 208.94 115.99 209.85 115.99 213.03C115.99 215.83 118.01 217.28 120.71 217.28ZM121.79 214.6C120.54 214.6 119.65 214.03 119.65 212.92C119.65 211.78 120.59 211.24 122 211.03C122.83 210.92 124.35 210.72 124.81 210.39V211.92C124.81 213.42 123.57 214.6 121.79 214.6ZM137.09 217.28C140.81 217.28 143.44 215.41 143.44 212.62C143.44 210.6 142.12 209.34 139.38 208.79L136.83 208.28C135.48 208 135 207.5 135 206.79C135 205.94 135.96 205.36 137.21 205.36C138.59 205.36 139.39 206.04 139.7 207.01L143.07 206.41C142.54 204.1 140.52 202.63 137.16 202.63C133.57 202.63 131.19 204.3 131.19 207.03C131.19 209.15 132.54 210.5 135.28 211.06L137.73 211.57C138.97 211.82 139.56 212.28 139.56 213.03C139.56 213.88 138.66 214.49 137.21 214.49C135.65 214.49 134.73 213.84 134.37 212.51L130.82 213.12C131.32 215.76 133.67 217.28 137.09 217.28ZM152.68 202.81H150.02V199.43H146.21V202.81H144.26V205.71H146.21V213.18C146.21 215.78 147.76 217.2 150.61 217.2C151.37 217.2 152.22 217.11 153.07 216.86L152.52 214C152.24 214.08 151.61 214.17 151.32 214.17C150.39 214.17 150.02 213.75 150.02 212.85V205.71H152.68ZM154.76 217H158.57V202.81H154.76ZM156.67 200.95C157.81 200.95 158.76 200.09 158.76 199C158.76 197.92 157.81 197.04 156.67 197.04C155.51 197.04 154.57 197.92 154.57 199C154.57 200.09 155.51 200.95 156.67 200.95ZM165.23 198.08H161.42V217H165.23ZM171.88 198.08H168.07V217H171.88ZM181.14 217.28C184.44 217.28 186.7 215.74 187.4 213.38L183.95 212.73C183.54 213.83 182.54 214.41 181.2 214.41C179.29 214.41 177.99 213.22 177.9 210.89H187.61V209.83C187.61 204.98 184.66 202.63 180.95 202.63C176.8 202.63 174.13 205.6 174.13 209.98C174.13 214.46 176.8 217.28 181.14 217.28ZM177.93 208.51C178.08 206.75 179.17 205.5 180.99 205.5C182.75 205.5 183.76 206.65 183.95 208.51Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="back">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.55" android:valueTo="1" android:valueType="floatType" android:duration="300" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.55" android:valueTo="1" android:valueType="floatType" android:duration="300" android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="backFill">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="140" android:interpolator="@android:interpolator/linear" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="card">
        <aapt:attr name="android:animation">
            <set>
                <set android:ordering="sequentially">
                    <objectAnimator android:propertyName="scaleX" android:valueFrom="0.86" android:valueTo="0.86" android:valueType="floatType" android:duration="80" />
                    <objectAnimator android:propertyName="scaleX" android:valueFrom="0.86" android:valueTo="1" android:valueType="floatType" android:duration="320" android:interpolator="@android:interpolator/linear_out_slow_in" />
                </set>
                <set android:ordering="sequentially">
                    <objectAnimator android:propertyName="scaleY" android:valueFrom="0.86" android:valueTo="0.86" android:valueType="floatType" android:duration="80" />
                    <objectAnimator android:propertyName="scaleY" android:valueFrom="0.86" android:valueTo="1" android:valueType="floatType" android:duration="320" android:interpolator="@android:interpolator/linear_out_slow_in" />
                </set>
                <set android:ordering="sequentially">
                    <objectAnimator android:propertyName="translateY" android:valueFrom="70" android:valueTo="70" android:valueType="floatType" android:duration="80" />
                    <objectAnimator android:propertyName="translateY" android:valueFrom="70" android:valueTo="0" android:valueType="floatType" android:duration="320" android:interpolator="@android:interpolator/linear_out_slow_in" />
                </set>
                <set android:ordering="sequentially">
                    <objectAnimator android:propertyName="rotation" android:valueFrom="-9" android:valueTo="-9" android:valueType="floatType" android:duration="80" />
                    <objectAnimator android:propertyName="rotation" android:valueFrom="-9" android:valueTo="0" android:valueType="floatType" android:duration="360" android:interpolator="@android:interpolator/fast_out_slow_in" />
                </set>
            </set>
        </aapt:attr>
    </target>
    <target android:name="frontFill">
        <aapt:attr name="android:animation">
            <set>
                <set android:ordering="sequentially">
                    <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="0" android:valueType="floatType" android:duration="80" />
                    <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="140" android:interpolator="@android:interpolator/linear" />
                </set>
            </set>
        </aapt:attr>
    </target>
    <target android:name="panel1">
        <aapt:attr name="android:animation">
            <set>
                <set android:ordering="sequentially">
                    <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="0" android:valueType="floatType" android:duration="220" />
                    <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="220" android:interpolator="@android:interpolator/fast_out_slow_in" />
                </set>
            </set>
        </aapt:attr>
    </target>
    <target android:name="panel2">
        <aapt:attr name="android:animation">
            <set>
                <set android:ordering="sequentially">
                    <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="0" android:valueType="floatType" android:duration="280" />
                    <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="220" android:interpolator="@android:interpolator/fast_out_slow_in" />
                </set>
            </set>
        </aapt:attr>
    </target>
    <target android:name="fold">
        <aapt:attr name="android:animation">
            <set>
                <set android:ordering="sequentially">
                    <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="0" android:valueType="floatType" android:duration="340" />
                    <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="180" android:interpolator="@android:anim/overshoot_interpolator" />
                </set>
                <set android:ordering="sequentially">
                    <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="0" android:valueType="floatType" android:duration="340" />
                    <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="180" android:interpolator="@android:anim/overshoot_interpolator" />
                </set>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
