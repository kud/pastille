<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Pastille" parent="android:Theme.Material.NoActionBar" />
    <style name="Theme.Pastille.Translucent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <!--
        Launch screen (core-splashscreen): the launcher mark on its navy disc, over the list's own
        ground so the hand-over is a fade, not a colour flash. On Android 12+ the mark assembles
        (drawable-v31/splash_icon.xml); before that, and with animations removed, it stands still.
    -->
    <style name="Theme.Pastille.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">520</item>
        <!-- The wordmark under the mark: Android 12+ branding slot; before that, in the window drawing. -->
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="31">@drawable/splash_wordmark</item>
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="postSplashScreenTheme">@style/Theme.Pastille</item>
    </style>
</resources>
